# load URLS on launch
auto-reload  yes

# dark mode
include ~/.newsboat/dark

# browser
browser "cha %u"

# launch video player
macro v set browser "setsid -f mpv" ; open-in-browser ; set browser "links %u"

# download video
macro d set browser "yt-dlp"; open-in-browser ; set browser "links %u"

# feed headings
highlight feedlist "---.*---" magenta default bold
feedlist-format "%4i %n %?L?%11u &?%t"
feedlist-format "%4i %n %t"

#!/bin/bash

source "$HOME/.secrets"

# Quality of Life
alias please='sudo '
alias open='xdg-open '
alias ls='ls -pa --color=auto --group-directories-first'
alias tree='tree -a -C -L 2 --dirsfirst --noreport'
alias recent='ls -t -1'
alias cp='cp -i'
alias cpv='rsync -ah --info=progress2'
alias mv='mv -i'
alias rm='rm -i'
alias mkdir='mkdir -p'
alias grep='grep --color=auto'
alias ..='cd ..'
alias home='cd ~'
alias back='cd "$OLDPWD"'
alias newterm='source $HOME/.aliases; clear; source $HOME/.zshrc'
alias cat='bat --paging=never'
alias bat='bat --paging=never --theme=Dracula'
alias diff='diff --side-by-side --color=always'
alias apt='nala '

# Power User
alias editfile='micro $(fzf --preview="cat {}")'
alias histsearch='history | grep '
alias trash='mv --force -t ~/.local/share/Trash'
alias quickdict='print -rl -- ${(k)commands} | sort -u | fzf --preview="tldr {}" | xargs -r tldr'
alias mansearch='print -rl -- ${(k)commands} | sort -u | fzf --preview="tldr {}" | xargs -r man'
alias backup='rsync -aAXHv --delete --info=progress2 /home/ /path/to/backup/home/'
alias diskuse='du -h --max-depth=1 2> /dev/null | sort -n -r | head -n20'

# System
alias reboot='sudo systemctl reboot'
alias poweroff='sudo systemctl poweroff'
alias suspend='sudo systemctl suspend'
alias df='df -h' # Human-readable disk usage
alias psg='ps aux | grep -v grep | grep -i' # Search running processes
alias ports='ss -tuln'  # Show open ports
alias cd='cl' # change dir; auto-ls
alias dirsize='du -hc . | tail -n 1'

# Informatic
alias whereami='curl -s ipinfo.io'
alias motd='cat /etc/motd | lolcat'
alias neofetch='fastfetch | lolcat'
alias yggdrasil='cbonsai -S | lolcat -a'
alias bonsai='cbonsai -S'
alias news='newsboat'
alias moon='curl wttr.in/Moon'
alias currentgame='gnugo -l $HOME/currentgame.sgf --mode ascii'
alias clock='tty-clock -c -C 5'

# Developer stuff
alias gitlog="git log --graph -n 5 --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias init-project='git init && python3 -m venv .venv && source .venv/bin/activate'
alias gen_todo='grep -rnw ./scripts -e TODO --exclude=TODO.md > TODO.md'
alias activate='source .venv/bin/activate'
alias gitroot='cd `git rev-parse --show-toplevel`'
alias gs='git status -sb'
alias ga='git add .'
alias gc='git commit -m'
alias gco='git checkout'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'
alias gundo='git reset --soft HEAD~1'
alias grev='git diff HEAD..origin/HEAD'

# General Music Aliases
#info shuffle='mpv --shuffle --vid=no $link' for common options
#info yt-dlp="yt-dlp --cookies-from-browser=brave" stops the cookie error
alias ytdl='yt-dlp --cookies-from-browser brave -x --audio-format opus "-o "$HOME/Music/%(title)s.%(ext)s'
alias ytdlpl='yt-dlp --cookies-from-browser brave -x --audio-format opus -o "$HOME/Music/%(playlist_title)s/%(playlist_index)02d - %(title)s.%(ext)s"'
alias mpv="mpv --ytdl-raw-options=cookies-from-browser=brave"

# Local Music Playlists
alias joker="mpv $HOME/Music/beneaththemask.opus"
alias bootleg="mpv --shuffle $HOME/Music/bootleglofi/*"
alias dwarffort="mpv --shuffle $HOME/Music/dwarfforts/*"
alias heathen="mpv --shuffle $HOME/Music/heathen/*"
alias postpunk="mpv --shuffle $HOME/Music/postpunk/*"
alias videogamemetal="mpv --shuffle $HOME/Music/videogamemetal/*"

# Online Music Playlists 
alias lofigirl="(mpv 'https://www.youtube.com/watch?v=jfKfPfyJRdk' > /dev/null 2>&1 &) && cava"
alias C418="(mpv 'https://www.youtube.com/watch?v=2xg71fa1CfI' > /dev/null 2>&1 &) && cava"
alias piano="(mpv 'https://www.youtube.com/watch?v=csxo1flT530' > /dev/null 2>&1 &) && cava"
alias metal="(mpv 'https://www.youtube.com/watch?v=9kGTJfwPSzI' > /dev/null 2>&1 &) && cava"
alias chiptune="(mpv 'https://www.youtube.com/watch?v=kYxMjsKT5Wk' > /dev/null 2>&1 &) && cava"
alias dnb="(mpv 'https://www.youtube.com/watch?v=GDtrDeaKpPc' > /dev/null 2>&1 &) && cava"
alias ifeellikemyself="(mpv 'https://www.youtube.com/watch?v=XGTIVDt7CfU' > /dev/null 2>&1 &) && cava"

# Functions
right_justify() {
  local width pad plain
  width=$(tput cols)
  while IFS= read -r line; do
    # Strip ANSI escape codes for accurate visible width
    plain=$(sed 's/\x1b\[[0-9;]*m//g' <<< "$line")
    pad=$((width - ${#plain}))
    if (( pad > 0 )); then
      printf "%*s%s\n" "$pad" "" "$line"
    else
      echo "$line"
    fi
  done
}

center_justify() {
  local width pad plain
  width=$(tput cols)
  while IFS= read -r line; do
    # Strip ANSI escape codes for visible width calculation
    plain=$(sed 's/\x1b\[[0-9;]*m//g' <<< "$line")
    pad=$(( (width - ${#plain}) / 2 ))
    if (( pad > 0 )); then
      printf "%*s%s\n" "$pad" "" "$line"
    else
      echo "$line"
    fi
  done
}

mkcd() { mkdir -p "$1" && cd "$1"; }

gitignore() {
	local gitrootdir="$(git rev-parse --show-toplevel)"
	git rm --cached "$1" -r
	echo "$1" >> "$gitrootdir/.gitignore"
}

countfiles() {
    local directory="$1"
    local count=$(find "$directory" -type f | wc -l)
    echo "Number of files in $directory: $count"
}

cl() {
    DIR="$*";
	# if no DIR given, go home
	if [ $# -lt 1 ]; then 
		DIR=$HOME;
  fi;
  builtin cd "${DIR}" && ls
}

searchpkg() {
	if type -p dnf &> /dev/null; then
		dnf list | fzf --preview='dnf info {1}'
	elif type -p nala &> /dev/null; then
		nala list | fzf --preview='nala info {1}'
	elif type -p apt &> /dev/null; then
		apt list 2>/dev/null | fzf --preview='apt show {1}'
	elif type -p pacman &> /dev/null; then
		pacman -Sl | fzf --preview='pacman -Si {2}'
	elif type -p yay &> /dev/null; then
		yay -Sl | fzf --preview='yay -Si {2}'
	elif type -p flatpak &> /dev/null; then
		flatpak remote-ls --system flathub --columns=ref | awk -F/ '{print $2}' | fzf --preview='flatpak search {1}' | xargs -r flatpak search
	fi
}

installpkg() {
	if type -p dnf &> /dev/null; then
		sudo dnf install $(dnf list | fzf -m --preview="dnf info {1}")
	elif type -p nala &> /dev/null; then
		selection=$(nala list | fzf --multi --preview='nala show {1}')
		[ -z "$selection" ] && return
		pkgs=$(echo "$selection" | awk '{print $1}')
		sudo nala install $pkgs
	elif type -p apt &> /dev/null; then
		selection=$(apt list 2>/dev/null | fzf --multi --preview='apt show {1}')
		[ -z "$selection" ] && return
		pkgs=$(echo "$selection" | cut -d/ -f1)
		sudo apt install $pkgs
	elif type -p yay &> /dev/null; then
		yay -S $(yay -Sl | fzf -m --preview="yay -Si {2}" | awk '{print $2}')
	elif type -p pacman &> /dev/null; then
		sudo pacman -S $(pacman -Sl | fzf -m --preview="pacman -Si {2}" | awk '{print $2}')
	elif type -p flatpak &> /dev/null; then
		selection=$(flatpak remote-ls --system flathub --columns=ref | awk -F/ '{print $2}' | fzf --multi --preview='flatpak search {1}')
		[ -z "$selection" ] && return
		flatpak install flathub $selection
	else
		echo "No supported package manager found."
	fi
}

uninstall() {
	if type -p dnf &> /dev/null; then
		sudo dnf remove "$@"
	fi
	if type -p nala &> /dev/null; then
		sudo nala remove
	fi
	if type -p \apt &> /dev/null; then
		sudo apt remove --purge "$@"
	fi
	if type -p pacman &> /dev/null; then
		sudo pacman -Rns "$@"
	fi
	if type -p yay &> /dev/null; then
		yay -Rns "$@"
	fi
	if type -p flatpak &> /dev/null; then
		flatpak remove "$@"
	fi
}

update() {
	if type -p dnf &> /dev/null; then # start with Fedora
		sudo dnf upgrade --refresh -y
		sudo dnf clean packages 
		sudo dnf clean dbcache
		sudo dnf autoremove -y
	elif type -p yay &> /dev/null || type -p pacman &> /dev/null; then # Arch
		if type -p yay &> /dev/null; then
			yay -Syu --noconfirm
			orphans=$(pacman -Qdtq 2>/dev/null)
			if [[ -n "$orphans" ]]; then
                yay -Rns $orphans --noconfirm
            fi
			yay -Sc --noconfirm
		else
			sudo pacman -Syu --noconfirm
			orphans=$(pacman -Qdtq 2>/dev/null)
			if [[ -n "$orphans" ]]; then
				sudo pacman -Rns $orphans --noconfirm
			fi
			sudo pacman -Sc --noconfirm
		fi
	elif type -p nala &> /dev/null || type -p apt &> /dev/null; then # Debian
		if type -p nala &> /dev/null; then
			sudo nala update
			sudo nala full-upgrade -y
			sudo nala autoremove -y
			sudo nala clean 
		else
			sudo apt update
			sudo apt full-upgrade -y
			sudo apt autoremove -y
			sudo apt autoclean
			sudo apt clean
		fi
	elif type -p zypper &> /dev/null; then # openSUSE
		sudo zypper refresh
		sudo zypper update -y
		sudo zypper clean --all
	elif type -p xbps-install &> /dev/null; then # Void Linux
    	sudo xbps-install -Su
		sudo xbps-remove -Oo
	elif type -p apk &> /dev/null; then # Alpine
		sudo apk update
		sudo apk upgrade
	fi
	if type -p flatpak &> /dev/null; then 
		flatpak update -y
	fi
	if type -p brew &> /dev/null; then
		brew update
		brew upgrade
		brew cleanup
	fi
}

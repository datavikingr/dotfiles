#!/usr/bin/env bash

# Get the hostname (machine name)
HOSTNAME=$(hostname)

# Pick the correct path based on the hostname
case "$HOSTNAME" in
  cloudchaser)
    CODE_DIR="$HOME/Code/caldav"
    ;;
  cloudrunner)
    CODE_DIR="$HOME/.local/share/calcurse"
    ;;
  localhost) 
    CODE_DIR="$HOME/Code/caldav"
    ;; # this is the phone
  *)
    echo "Unknown host: $HOSTNAME"
    exit 1
    ;;
esac

# Navigate and pull
cd "$CODE_DIR/caldav" || { echo "Directory not found: $CODE_DIR/caldav"; exit 1; }
git pull origin main

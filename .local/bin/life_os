#!/usr/bin/env bash
set -euo pipefail
SESSION="life_os"

# Attach if the session already exists.
if tmux has-session -t "$SESSION" 2>/dev/null; then
    exec tmux attach-session -t "$SESSION"
fi

# Start the session detached.
tmux new-session -d -s "$SESSION" -n "files"

# Window 1: File manager
tmux send-keys -t "$SESSION:files" "tfm" C-m

# Window 2: Calendar
tmux new-window -t "$SESSION" -n "calendar"
tmux send-keys -t "$SESSION:calendar" "calcurse" C-m

# Window 3: News
tmux new-window -t "$SESSION" -n "news"
tmux send-keys -t "$SESSION:news" "newsboat" C-m

# Window 4: Weather
tmux new-window -t "$SESSION" -n "weather"
tmux send-keys -t "$SESSION:weather" "curl wttr.in" C-m

# Window 5: Browser
tmux new-window -t "$SESSION" -n "browser"
<<<<<<< Updated upstream
tmux send-keys -t "$SESSION:browser" "chawan https://duckduckgo.com" C-m

# Window 6: Communications
tmux new-window -t "$SESSION" -n "signal"
tmux send-keys -t "$SESSION:signal" "gurk" C-m

# Window 7: Recreation / shell
tmux new-window -t "$SESSION" -n "term"
tmux send-keys -t "$SESSION:term" "clear && hackerlogin.sh" C-m

# Return to the first window.
tmux select-window -t "$SESSION:term"

# Attach.
exec tmux attach-session -t "$SESSION"
